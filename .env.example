# Database URL (PostgreSQL / Prisma configuration)
DATABASE_URL="postgresql://user:password@localhost:5432/campus_ai_hub?schema=public"

# Authentication
JWT_SECRET="campus-ai-hub-super-secret-jwt-key-2026"

# AI Service Configuration (Configurable for Google Gemini or custom LLM)
AI_API_KEY=""
AI_MODEL="gemini-3.8-flash"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server & Runtime
PORT=3000
CLIENT_URL="http://localhost:3000"
UPLOAD_DIR="uploads"

# APP_URL: Injected automatically by AI Studio at runtime
APP_URL="MY_APP_URL"

